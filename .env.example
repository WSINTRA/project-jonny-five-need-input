# Docker Neo4j container
NEO4J_AUTH=neo4j/
NEO4J_PORT_HTTP=7474
NEO4J_PORT_BOLT=7687
NEO4J_DATA_DIR=$HOME/neo4j/delboy
DOCKER_USER=

# Server Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
SERVER_ADDR=:9090

# Docker llama.cpp server
LLAMA_SERVER_PORT=8081
LLAMA_MODELS_DIR=$HOME/llama/models
LLAMA_MODEL=qwen2.5-7b-q4_k_m.gguf
LLAMA_CTX_SIZE=8192
LLAMA_THREADS=8

# Agent configuration
LLAMA_SERVER_URL=http://localhost:8081
SERVER_URL=http://localhost:9090
